      "score": 19,
      "maximum": 20
    },
    "unresolved": {
      "p0": 0,
      "p1": 0
    },
    "detector": {
      "posture": "advisory",
      "findings": []
    }
  },
  "ownerFeedback": {
    "decision": "pending",
    "note": "Owner approved implementation; final rendered-surface feedback remains pending."
  }
