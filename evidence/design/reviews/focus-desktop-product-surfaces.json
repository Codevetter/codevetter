{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "codevetter",
  "target": "five-surface desktop shell and Performance workbench",
  "mode": "preserve",
  "register": "product",
  "context": {
    "product": "PRODUCT.md",
    "design": "DESIGN.md"
  },
  "direction": {
    "references": [],
    "probes": [],
