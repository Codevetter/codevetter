{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/landing-page-astro": {
      "entry": ["src/pages/**/*.{astro,ts}"],
      "project": ["src/**/*.{ts,astro}"]
    }
  },
  "ignoreDependencies": ["ccusage", "tailwindcss"],
  "ignoreBinaries": [
    "actionlint",
    "cargo-deny",
    "ditto",
    "du",
    "go",
    "gitleaks",
    "lsof",
    "netstat",
    "osascript",
    "plutil",
    "ps",
    "rustc",
    "sips",
    "spctl",
    "xcode-select"
  ],
  "ignoreIssues": {
    "**/commands/**": ["exports", "types"]
  }
}
