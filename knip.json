{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs"
      ]
    },
    "apps/desktop": {
      "entry": [
        "scripts/**/*.mjs",
        "tests/**/*.spec.ts",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.mjs"
      ]
    },
    "apps/landing-page-astro": {
      "entry": [
        "src/pages/**/*.{astro,ts}"
      ],
      "project": [
        "src/**/*.{ts,astro}"
      ]
    }
  },
  "ignoreDependencies": [
    "tailwindcss",
    "ccusage"
  ],
  "ignoreBinaries": [
    "actionlint",
    "cargo-deny",
    "ditto",
    "du",
    "go",
    "gitleaks",
    "lipo",
    "lsof",
    "netstat",
    "osascript",
    "plutil",
    "ps",
    "rustc",
    "sips",
    "spctl",
    "swift",
    "tauri",
    "xcode-select"
  ],
  "ignoreIssues": {
    "apps/desktop/src/lib/business-rule-archaeology/qualification-policy.ts": [
      "exports",
      "types"
    ],
    "apps/desktop/src/lib/scenario-compiler/candidate.ts": [
      "exports",
      "types"
    ],
