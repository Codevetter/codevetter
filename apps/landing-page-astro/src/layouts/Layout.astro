---
import '@/styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const SITE_URL = 'https://codevetter.com';

const {
  title = 'CodeVetter — Execution-backed agent verification',
  description = 'Verify coding-agent changes with executable checks, inspectable evidence, explicit limitations, and a measurable verdict.',
  path = '/',
} = Astro.props;

// Clamp meta description to 70–160 chars for SEO best practice.
const DEFAULT_DESC = 'Execution-backed verification for coding-agent changes, with local checks, portable evidence, and explicit limitations.';
function clampDescription(desc: string, fallback: string = DEFAULT_DESC): string {
  let d = (desc ?? '').trim();
  if (d.length === 0) return fallback;
  if (d.length > 160) {
    d = d.slice(0, 157).replace(/\s+\S*$/, '').trim();
    if (d.length > 0) d += '…';
    return d;
  }
  if (d.length < 70) {
    const f = fallback.trim();
    if (d.length > 0 && f.length > 0) {
      const separator = /[.!?]$/.test(d) ? ' ' : '. ';
      const combined = `${d}${separator}${f}`;
      if (combined.length <= 160) return combined;
      return combined.slice(0, 157).replace(/\s+\S*$/, '').trim() + '…';
    }
    return f || d;
  }
  return d;
}
const clampedDescription = clampDescription(description);

function normalizePublicPath(value: string): string {
  if (value === '/') return '';
  return `/${value.replace(/^\/+|\/+$/g, '')}`;
}

const normalizedPath = normalizePublicPath(path);
const canonical = `${SITE_URL}${normalizedPath}`;
const markdownPath = normalizedPath.length === 0 ? '/index.md' : `${normalizedPath}.md`;
const markdownAlternate = `${SITE_URL}${markdownPath}`;
// Reuse the OG image generated by the old Next.js build at
// https://codevetter.com/opengraph-image. Post-cutover, the CF Pages
// project serves /, so this absolute URL falls back to a stable image
// asset if we publish one to public/og.png later. For now, keep the
// existing visual contract.
const OG_IMAGE = `${SITE_URL}/og-image.png`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={clampedDescription} />
    <meta name="application-name" content="CodeVetter" />
    <meta name="keywords" content="coding agent verification, AI code verification, executable evidence, agent evaluation, software verification, local developer tool, verification receipt" />
    <meta name="author" content="CodeVetter" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdownAlternate} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CodeVetter" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={clampedDescription} />
    <meta property="og:image" content={OG_IMAGE} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={clampedDescription} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:site" content="@sarthakcodes" />
    <meta name="twitter:creator" content="@sarthakcodes" />

