---
import Footer from '@/components/Footer.astro';
import Nav from '@/components/Nav.astro';
import { articlesContent } from '@/data/articles-content';
import Layout from '@/layouts/Layout.astro';

const articles = Object.values(articlesContent);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'CodeVetter articles',
      description:
        'Editorial articles on execution-backed coding-agent verification, reproducible evidence, and verification receipts.',
      url: 'https://codevetter.com/articles',
      publisher: { '@type': 'Organization', name: 'CodeVetter', url: 'https://codevetter.com' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'CodeVetter', item: 'https://codevetter.com/' },
        { '@type': 'ListItem', position: 2, name: 'Articles', item: 'https://codevetter.com/articles' },
      ],
    },
  ],
};
---

<Layout
  title="Articles — CodeVetter"
  description="Editorial articles on execution-backed coding-agent verification, reproducible evidence, and verification receipts."
  path="/articles"
>
  <main class="min-h-screen bg-[--color-bg] text-[--color-text]">
    <Nav />
    <article class="mx-auto max-w-3xl px-6 pb-24 pt-32">
      <header class="border-b border-[--color-line] pb-12">
        <a href="/" class="font-mono text-xs text-[--color-text-mute] hover:text-[--color-accent]">← CodeVetter</a>
        <p class="mt-8 font-mono text-xs uppercase tracking-[0.16em] text-[--color-accent]">Verification field guide</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-white md:text-6xl">Articles</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-[--color-text-dim]">
          Editorial pieces on verifying coding-agent changes with executable checks, reproducible
          evidence, and explicit verdicts instead of another model's opinion.
        </p>
      </header>

      <div class="mt-12 flex flex-col gap-10">
        {articles.map((article) => (
          <a href={article.path} class="group block border-b border-[--color-line] pb-10">
            <h2 class="text-xl font-semibold tracking-tight text-white group-hover:text-[--color-accent]">
              {article.title}
            </h2>
            <p class="mt-3 leading-7 text-[--color-text-dim]">{article.description}</p>
            <p class="mt-4 font-mono text-xs text-[--color-accent]">Read article →</p>
          </a>
        ))}
      </div>
    </article>
    <Footer />
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
