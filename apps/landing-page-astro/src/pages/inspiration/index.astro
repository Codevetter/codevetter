---
import Footer from '@/components/Footer.astro';
import Nav from '@/components/Nav.astro';
import { inspirations, type InspirationCategory } from '@/data/inspirations';
import Layout from '@/layouts/Layout.astro';

const categories: InspirationCategory[] = ['Verification', 'Code context', 'Agent workflows', 'Building blocks'];
const counts = Object.fromEntries(categories.map((category) => [category, inspirations.filter((item) => item.category === category).length]));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Tools that shaped CodeVetter',
  description: 'An attributed ledger of products and open-source tools studied while building CodeVetter.',
  url: 'https://codevetter.com/inspiration',
  hasPart: inspirations.map((item) => ({ '@type': 'Article', name: item.name, url: `https://codevetter.com/inspiration/${item.slug}` })),
};
---

<Layout
  title="Inspiration — CodeVetter"
  description="A detailed, source-linked ledger of the tools and ideas that shaped CodeVetter's approach to code context, agent workflows, and executable verification."
  path="/inspiration"
>
  <main class="inspiration-shell">
    <Nav />
    <div class="ledger-wrap">
      <header class="ledger-intro">
        <div class="ledger-kicker"><span class="ledger-mark">CV / FIELD NOTES</span><span>REFERENCE LEDGER · 2026</span></div>
        <h1>Built with <em>respect</em> for what came before.</h1>
        <p class="ledger-lede">The products, open-source projects, and engineering ideas we studied while building CodeVetter. Each note names a concrete lesson and the boundary of our own work.</p>
        <p class="ledger-disclosure">Inclusion acknowledges research or inspiration. It does not imply endorsement, affiliation, code reuse, or feature parity. “In the product” identifies a bounded integration; the other labels describe research.</p>
        <div class="ledger-facts" aria-label="Ledger summary">
          <span><strong>{inspirations.length}</strong> source-linked notes</span>
          <span><strong>{categories.length}</strong> areas of influence</span>
          <a href="https://github.com/Codevetter/codevetter/blob/main/docs/knowledge/codebase-context-tools-landscape.md">Read the wider research archive ↗</a>
        </div>
      </header>

      <section class="ledger-section" aria-labelledby="ledger-heading">
        <div class="ledger-section-title"><span id="ledger-heading">THE LEDGER</span><span id="visible-count" aria-live="polite">{inspirations.length} ENTRIES</span></div>
        <div class="ledger-controls">
          <label class="search-label" for="ledger-search">Search the notes</label>
          <input id="ledger-search" type="search" placeholder="Search a tool or idea…" autocomplete="off" />
          <div class="ledger-filters" role="group" aria-label="Filter by area">
            <button type="button" class="is-active" data-category="all" aria-pressed="true">All <span>{inspirations.length}</span></button>
            {categories.map((category) => <button type="button" data-category={category} aria-pressed="false">{category} <span>{counts[category]}</span></button>)}
          </div>
        </div>
        <div class="ledger-table-head" aria-hidden="true"><span>TOOL / PROJECT</span><span>WHAT WE LEARNED</span><span>RELATION</span><span>NOTE</span></div>
        <div class="ledger-rows" id="ledger-rows">
          {inspirations.map((item, index) => (
            <a
              href={`/inspiration/${item.slug}`}
              class="ledger-row"
              data-category={item.category}
              data-search={`${item.name} ${item.category} ${item.relation} ${item.idea} ${item.lesson}`.toLocaleLowerCase()}
            >
              <span class="row-tool"><span class="row-number">{String(index + 1).padStart(2, '0')}</span><span><strong>{item.name}</strong><small>{item.category}</small></span></span>
              <span class="row-idea">{item.idea}</span>
              <span class="row-relation">{item.relation}</span>
              <span class="row-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <p class="ledger-empty" id="ledger-empty" hidden>No matching notes. Try a tool name or a broader idea.</p>
      </section>
      <aside class="ledger-endnote">A landscape survey can be broad. This ledger gives a dedicated note to each tool for which the project records a specific lesson. The longer <a href="https://github.com/Codevetter/codevetter/blob/main/docs/knowledge/codebase-context-tools-landscape.md">research snapshot</a> also lists alternatives we evaluated without adopting their approach.</aside>
    </div>
    <Footer />
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<script>
  const search = document.querySelector<HTMLInputElement>('#ledger-search');
  const rows = [...document.querySelectorAll<HTMLElement>('.ledger-row')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.ledger-filters button')];
  const count = document.querySelector<HTMLElement>('#visible-count');
  const empty = document.querySelector<HTMLElement>('#ledger-empty');
  let category = 'all';

  function filterRows() {
    const query = search?.value.trim().toLocaleLowerCase() ?? '';
    let visible = 0;
    for (const row of rows) {
      const matches = (category === 'all' || row.dataset.category === category) && (row.dataset.search ?? '').includes(query);
      row.hidden = !matches;
      if (matches) visible += 1;
    }
    if (count) count.textContent = `${visible} ${visible === 1 ? 'ENTRY' : 'ENTRIES'}`;
    if (empty) empty.hidden = visible !== 0;
  }

  search?.addEventListener('input', filterRows);
  for (const button of buttons) {
    button.addEventListener('click', () => {
      category = button.dataset.category ?? 'all';
      for (const other of buttons) {
        const active = other === button;
        other.classList.toggle('is-active', active);
        other.setAttribute('aria-pressed', String(active));
      }
      filterRows();
    });
  }
</script>

<style>
  .inspiration-shell{min-height:100vh;background:#090a0b;color:#e8e5df}.ledger-wrap{max-width:1240px;margin:auto;padding:150px 28px 112px}.ledger-kicker,.ledger-section-title,.ledger-table-head,.ledger-facts,.ledger-controls,.row-number,.row-relation,.row-arrow,.ledger-disclosure,.ledger-endnote{font-family:var(--font-mono)}.ledger-kicker{display:flex;gap:18px;align-items:center;color:#bba484;font-size:11px;letter-spacing:.14em}.ledger-mark{padding:7px 9px;border:1px solid #766853;color:#e4c598}.ledger-intro{padding-bottom:58px;border-bottom:1px solid #34302b}.ledger-intro h1{max-width:820px;margin:36px 0 22px;font-size:clamp(42px,6.6vw,84px);line-height:1.04;letter-spacing:-.065em;font-weight:580}.ledger-intro h1 em{font-family:Georgia,serif;color:#c8ac85;font-weight:400}.ledger-lede{max-width:760px;color:#bab7b0;font-size:clamp(17px,2vw,22px);line-height:1.6}.ledger-disclosure{max-width:820px;margin-top:26px;color:#8e8b85;font-size:11px;line-height:1.8}.ledger-facts{display:flex;flex-wrap:wrap;gap:28px;margin-top:36px;color:#99968f;font-size:11px;letter-spacing:.04em}.ledger-facts strong{color:#e8d3b4;font-size:18px;font-weight:500}.ledger-facts a,.ledger-endnote a{color:#d8b987;text-underline-offset:3px}.ledger-section{margin-top:44px}.ledger-section-title{display:flex;justify-content:space-between;gap:16px;color:#bfa988;font-size:11px;letter-spacing:.18em}.ledger-controls{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:24px 0 18px}.search-label{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.ledger-controls input{min-width:235px;width:min(360px,100%);padding:12px 14px;border:1px solid #45403a;background:#101112;color:#f5f0e7;font:12px var(--font-mono);outline:none}.ledger-controls input:focus-visible{border-color:#d4b488;box-shadow:0 0 0 2px #d4b48840}.ledger-controls input::placeholder{color:#8d8982}.ledger-filters{display:flex;flex-wrap:wrap;gap:5px}.ledger-filters button{cursor:pointer;border:1px solid transparent;padding:9px 10px;background:transparent;color:#96938d;font:11px var(--font-mono)}.ledger-filters button span{padding-left:5px;color:#6f6b65}.ledger-filters button:hover,.ledger-filters button:focus-visible{color:#ede3d5;border-color:#716149}.ledger-filters button.is-active{color:#ebcfaa;border-color:#746046;background:#211c17}.ledger-table-head,.ledger-row{display:grid;grid-template-columns:minmax(180px,1.2fr) minmax(260px,2.3fr) minmax(130px,.9fr) 35px;gap:22px;align-items:center}.ledger-table-head{padding:15px 18px;color:#88847e;border-top:1px solid #45403a;border-bottom:1px solid #45403a;font-size:10px;letter-spacing:.13em}.ledger-row{min-height:93px;padding:17px 18px;text-decoration:none;color:inherit;border-bottom:1px solid #2b2926;transition:background .18s ease}.ledger-row:hover,.ledger-row:focus-visible{background:#191815;outline:none}.ledger-row:focus-visible{box-shadow:inset 0 0 0 2px #c6a77a}.ledger-row[hidden]{display:none}.row-tool{display:flex;gap:19px;align-items:baseline}.row-number{color:#806f59;font-size:10px}.row-tool strong{display:block;color:#eee8de;font-weight:550;font-size:16px}.row-tool small{display:block;margin-top:6px;color:#938f88;font:11px var(--font-mono)}.row-idea{color:#bab7b0;font-size:14px;line-height:1.5}.row-relation{color:#bbaa91;font-size:11px}.row-arrow{justify-self:end;color:#c8a977;font-size:19px}.ledger-empty{padding:30px 18px;color:#bab7b0}.ledger-endnote{max-width:780px;margin-top:44px;color:#8f8c86;font-size:11px;line-height:1.8}@media(max-width:850px){.ledger-controls{align-items:flex-start;flex-direction:column}.ledger-filters{width:100%}.ledger-table-head{display:none}.ledger-row{grid-template-columns:minmax(160px,1fr) minmax(200px,1.4fr) 26px;gap:18px}.row-relation{display:none}}@media(max-width:580px){.ledger-wrap{padding:124px 19px 72px}.ledger-kicker{font-size:9px;gap:8px}.ledger-intro h1{margin-top:27px}.ledger-facts{gap:16px}.ledger-section{margin-top:34px}.ledger-controls input{width:100%}.ledger-filters button{padding:8px 7px;font-size:10px}.ledger-row{grid-template-columns:1fr 24px;gap:9px;min-height:0;padding:19px 6px}.row-tool{grid-column:1;gap:12px}.row-idea{grid-column:1;padding-left:27px;font-size:13px}.row-arrow{grid-column:2;grid-row:1/3}.ledger-section-title{font-size:10px}}
</style>
