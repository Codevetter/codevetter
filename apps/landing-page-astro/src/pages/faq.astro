---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import FAQ from '@/components/FAQ.astro';
import Footer from '@/components/Footer.astro';
---

<Layout
  title="CodeVetter FAQ — Agent verification, evidence, and privacy"
  description="Clear answers about CodeVetter's execution-backed agent verification, local evidence, provider boundary, benchmark, and current macOS availability."
  path="/faq"
>
  <main class="min-h-screen bg-[--color-bg] text-[--color-text]">
    <Nav />
    <div class="pt-10">
      <FAQ headingLevel="h1" />
    </div>
    <Footer />
  </main>
</Layout>
