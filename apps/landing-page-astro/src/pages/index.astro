---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import CatchStrip from '@/components/CatchStrip.astro';
import Stats from '@/components/Stats.astro';
import Bento from '@/components/Bento.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import Providers from '@/components/Providers.astro';
import Availability from '@/components/Availability.astro';
import CTA from '@/components/CTA.astro';
import FAQ from '@/components/FAQ.astro';
import Footer from '@/components/Footer.astro';

// CodeVetter landing — execution-backed verification positioning.
---

<Layout
  title="CodeVetter — Execution-backed agent verification"
  description="Verify whether a coding agent completed its task. CodeVetter binds the exact change to executable checks, inspectable evidence, limitations, and a measurable verdict."
  path="/"
>
  <main>
    <Nav />
    <Hero />
    {/* Section wrappers preserve document order and anchor behavior. */}
    <div class="cv-below-fold"><CatchStrip /></div>
    <div class="cv-below-fold"><Stats /></div>
    <div class="cv-below-fold"><Bento /></div>
    <div class="cv-below-fold"><HowItWorks /></div>
    <div class="cv-below-fold"><Providers /></div>
    <div class="cv-below-fold"><Availability /></div>
    <div class="cv-below-fold"><CTA /></div>
    <div class="cv-below-fold"><FAQ /></div>
    <div class="cv-below-fold"><Footer /></div>
  </main>
</Layout>
