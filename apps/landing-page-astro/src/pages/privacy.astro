---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { privacyInlineHtml, privacyPolicy } from '@/data/privacy';

// Rendered from src/data/privacy.ts, the single source shared with
// /privacy.md (src/data/agent-markdown.ts). Do not restate the policy text
// here — edit the data file so both surfaces move together (#254).

const canonical = `https://codevetter.com${privacyPolicy.path}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PrivacyPolicy',
  name: privacyPolicy.title,
  description: privacyPolicy.description,
  url: canonical,
  dateModified: privacyPolicy.lastUpdated,
  inLanguage: 'en',
  publisher: { '@type': 'Organization', name: 'CodeVetter', url: 'https://codevetter.com' },
};
---

<Layout hasProductFooter
  title={privacyPolicy.seoTitle}
  description={privacyPolicy.description}
  path={privacyPolicy.path}
>
  <main class="min-h-screen bg-stone-950 text-stone-200">
    <Nav />
    <article class="mx-auto max-w-3xl px-4 py-16 leading-7 pt-32">
      <a href="/" class="text-xs text-stone-500 hover:text-amber-400">
        ← CodeVetter
      </a>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-white">
        Privacy
      </h1>
      <p class="mt-3 text-xs text-stone-500">
        Last updated: {privacyPolicy.lastUpdated}.
      </p>

      {privacyPolicy.sections.map((section) => (
        <>
          <h2 class="mt-8 text-base font-semibold text-white">{section.heading}</h2>
          {(section.paragraphs ?? []).map((paragraph) => (
            <p class="mt-2 text-sm" set:html={privacyInlineHtml(paragraph)} />
          ))}
          {(section.bullets ?? []).length > 0 && (
            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm marker:text-stone-600">
              {(section.bullets ?? []).map((bullet) => (
                <li>
                  {bullet.label && <strong>{bullet.label}</strong>}{bullet.label ? ' ' : ''}
                  <Fragment set:html={privacyInlineHtml(bullet.text)} />
                </li>
              ))}
            </ul>
          )}
        </>
      ))}
    </article>
    <Footer />
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
