---
import Layout from '@/layouts/Layout.astro';
import reports from '@/data/unpack-reports.json';
import SECTION_TITLES from '@/data/unpack-sections.json';

export function getStaticPaths() {
  const paths = [];
  for (const report of reports as any[]) {
    if (!report.sections) continue;
    for (const [key, title] of Object.entries(SECTION_TITLES)) {
      const section = report.sections[key];
      if (!section) continue;
      paths.push({
        params: { slug: report.slug, section: key.replace(/_/g, '-') },
        props: { report, section, sectionKey: key, title },
      });
    }
  }
  return paths;
}

const { report, section, sectionKey, title } = Astro.props;
---

<Layout
  title={`${title} — ${report.repo} codebase unpack`}
  description={`${title} for ${report.repo}: claim-cited analysis at commit ${report.commit.sha.slice(0, 7)}, generated by CodeVetter Repo Unpack.`}
>
  <main class="report">
    <a class="back" href={`/unpack/${report.slug}`}>← {report.repo}</a>
    <header>
      <div class="eyebrow">CodeVetter · Repo Unpack · {title}</div>
      <h1>{report.repo}</h1>
      <p class="meta">
        Scanned commit <code>{report.commit.sha.slice(0, 10)}</code> dated {report.commit.date} — last
        upstream commit. Generated by <code>codevetter {report.codevetterVersion}</code> on{' '}
        {report.collectedAt.slice(0, 10)}.
        {report.analysis && (
          <>
            {' '}Deep analysis by <code>{report.analysis.model}</code> via the {report.analysis.agent}{' '}
            CLI on {report.analysis.collected_at.slice(0, 10)} (
            {Math.round(report.analysis.runtime_ms / 1000)}s).
          </>
        )}
      </p>
    </header>

    <section>
      <p class="summary">{section.summary}</p>
      <ul>
        {section.claims.map((c) => (
          <li>
            {c.claim}
            {c.kind === 'inference' && <span class="dim"> (inferred)</span>}
            <div class="sources">
              {(c.sources ?? []).map((s) => (
                <a href={`https://github.com/${report.repo}/blob/${report.commit.sha}/${s.split('#')[0]}`}>
                  {s}
                </a>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <aside>
      Every claim cites the file(s) it was read from at commit {report.commit.sha.slice(0, 7)}.
      Claims marked "inferred" are reading-between-the-lines; the rest are directly evidenced. This
      is an independent CodeVetter scan — not reviewed by upstream maintainers.
    </aside>

    <nav class="more">
      <h2>More on {report.repo}</h2>
      <ul>
        {Object.entries(SECTION_TITLES)
          .filter(([k]) => report.sections[k] && k !== sectionKey)
          .map(([k, t]) => (
            <li>
              <a href={`/unpack/${report.slug}/${k.replace(/_/g, '-')}`}>{t}</a>
            </li>
          ))}
      </ul>
    </nav>
  </main>
</Layout>

<style>
  .report{width:min(920px,calc(100% - 40px));margin:0 auto;padding:140px 0 90px}.back{color:#8c8e94;text-decoration:none;font-size:.85rem}header{padding:54px 0 34px;border-bottom:1px solid #24262b}.eyebrow{color:#85888f;text-transform:uppercase;letter-spacing:.16em;font-size:.7rem}h1{color:#f0efeb;font-size:clamp(2.2rem,5vw,3.8rem);line-height:1.02;letter-spacing:-.05em;margin:16px 0;font-family:ui-monospace,monospace}.meta{color:#85888f;font-size:.9rem;line-height:1.6}section{margin-top:44px}h2{color:#e9e8e4;font-size:1.1rem;margin-bottom:16px}code{color:#8b8e95;font-size:.85em}p{color:#92969e;line-height:1.65}li{color:#c9cbd1;line-height:1.8;list-style:none;padding-left:0;margin-bottom:14px}.sources{margin-top:4px}.sources a{display:inline-block;margin:2px 10px 2px 0;font-family:ui-monospace,monospace;font-size:.75rem;color:#8b8e95;text-decoration:none}.sources a:hover{color:#d9b567}ul{padding-left:0}.dim{color:#73767d}.summary{font-size:1.05rem;line-height:1.7}aside{margin-top:44px;padding:20px;border-left:2px solid #d4a039;background:#101114;color:#92959c;line-height:1.65;font-size:.9rem}.more{margin-top:44px}.more a{color:#d9b567;text-decoration:none}.more a:hover{text-decoration:underline}
</style>
