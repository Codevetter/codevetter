---
import Footer from '@/components/Footer.astro';
import Nav from '@/components/Nav.astro';
import reports from '@/data/unpack-reports.json';
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Repo Unpack evidence — public codebase scans"
  description="Deterministic Repo Unpack scans of well-known open-source repositories: languages, structure, entrypoints, health signals, and history — with the scanned commit and engine version on every page."
  path="/unpack"
>
  <Nav />
  <main class="index">
    <header>
      <div class="eyebrow">CodeVetter · Repo Unpack evidence</div>
      <h1>Public codebase unpacks</h1>
      <p>
        Each page is a deterministic structural scan of a well-known open-source repository at a
        pinned commit — what CodeVetter's Repo Unpack produces before any model analysis. Scan
        date, engine version, and the upstream commit are printed on every page.
      </p>
    </header>
    <ul>
      {reports.map((r) => (
        <li>
          <a href={`/unpack/${r.slug}`}>
            <strong>{r.repo}</strong>
            <span>{r.stats.filesScanned} files · {r.languages[0]?.language ?? 'mixed'} · {r.commit.date}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</Layout>

<style>
  .index{width:min(920px,calc(100% - 40px));margin:0 auto;padding:140px 0 90px}.eyebrow{color:#85888f;text-transform:uppercase;letter-spacing:.16em;font-size:.7rem}h1{color:#f0efeb;font-size:clamp(2.4rem,6vw,4.5rem);letter-spacing:-.055em;margin:16px 0}header p{color:#85888f;line-height:1.7;max-width:640px}header{padding:54px 0 34px;border-bottom:1px solid #24262b}ul{list-style:none;padding:0;margin-top:24px}li a{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:16px 0;border-bottom:1px solid #1c1f24;text-decoration:none}li strong{color:#eeede9;font-family:ui-monospace,monospace;font-weight:500}li span{color:#73767d;font-size:.85rem;white-space:nowrap}
</style>
