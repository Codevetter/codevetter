---
import Footer from '@/components/Footer.astro';
import Nav from '@/components/Nav.astro';
import reports from '@/data/unpack-reports.json';
import Layout from '@/layouts/Layout.astro';

export function getStaticPaths() {
  return reports.map((report) => ({ params: { slug: report.slug }, props: { report } }));
}

const { report } = Astro.props;
const totalBytes = report.languages.reduce((sum, l) => sum + l.bytes, 0);
const langShare = (bytes: number) => Math.round((bytes / Math.max(totalBytes, 1)) * 100);
---

<Layout
  title={`${report.repo} — codebase unpack`}
  description={`Deterministic Repo Unpack evidence scan of ${report.repo} at commit ${report.commit.sha.slice(0, 7)}: languages, structure, entrypoints, health signals, and recent history.`}
  path={`/unpack/${report.slug}`}
>
  <Nav />
  <main class="report">
    <a class="back" href="/unpack">← All unpacks</a>
    <header>
      <div class="eyebrow">CodeVetter · Repo Unpack evidence</div>
      <h1>{report.repo}</h1>
      <p class="meta">
        Scanned commit <code>{report.commit.sha.slice(0, 10)}</code> dated {report.commit.date} —
        last upstream commit. Generated by <code>{report.codevetterVersion}</code> on
        {' '}{new Date(report.collectedAt).toISOString().slice(0, 10)}.
      </p>
      <p class="upstream">
        <a href={`https://github.com/${report.repo}`}>github.com/{report.repo} ↗</a>
        {' '}· {report.stats.filesScanned} files · {report.stats.size}
        {report.stats.maxFilesHit ? ' · scan capped' : ''}
      </p>
      {report.readmePreview && <p class="lead">{report.readmePreview}</p>}
    </header>

    <section>
      <h2>Languages</h2>
      <table>
        <thead><tr><th>Language</th><th>Files</th><th>Share</th></tr></thead>
        <tbody>
          {report.languages.map((l) => (
            <tr><td>{l.language}</td><td>{l.files}</td><td>{langShare(l.bytes)}%</td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section>
      <h2>Repository structure</h2>
      <table>
        <thead><tr><th>Top-level path</th><th>Files</th></tr></thead>
        <tbody>
          {report.topDirs.map((d) => (
            <tr><td><code>{d.path}/</code></td><td>{d.file_count}</td></tr>
          ))}
        </tbody>
      </table>
      {report.docs.length > 0 && (
        <p class="docs">Docs found: {report.docs.map((d) => <code>{d}</code>)}</p>
      )}
    </section>

    {report.manifest && (
      <section>
        <h2>Package</h2>
        <p>
          <code>{report.manifest.path}</code> — <strong>{report.manifest.name}</strong>
          {report.manifest.version && <> v{report.manifest.version}</>}
          {', '}{report.manifest.dependencyCount} declared dependencies.
        </p>
        {report.manifest.dependencies.length > 0 && (
          <p class="deps">{report.manifest.dependencies.map((d) => <code>{d}</code>)}</p>
        )}
      </section>
    )}

    {report.entrypoints.length > 0 && (
      <section>
        <h2>Detected entrypoints</h2>
        <ul>
          {report.entrypoints.map((e) => (
            <li><code>{e.path}</code> <span class="dim">— {e.reason}</span></li>
          ))}
        </ul>
      </section>
    )}

    {report.health && (
      <section>
        <h2>Structural health signals</h2>
        <p>
          Average score <strong>{report.health.averageScore}/10</strong> across{' '}
          {report.health.filesAnalyzed} analyzed source files; {report.health.hotspotCount}{' '}
          hotspot{report.health.hotspotCount === 1 ? '' : 's'} surfaced.
        </p>
        {report.health.topFiles.length > 0 && (
          <ul>
            {report.health.topFiles.map((f) => (
              <li>
                <code>{f.path}</code> — {f.lines} lines, score {f.score}
                {f.findings.length > 0 && <span class="dim"> ({f.findings.join(', ')})</span>}
              </li>
            ))}
          </ul>
        )}
        <p class="note">
          These are deterministic review leads — size, churn, and structural signals — not proof of
          a bug in this project.
        </p>
      </section>
    )}

    {report.history.length > 0 && (
      <section>
        <h2>Recent history</h2>
        <ul>
          {report.history.map((c) => (
            <li><code>{c.sha}</code> <span class="dim">{c.date}</span> — {c.subject}</li>
          ))}
        </ul>
      </section>
    )}

    <aside>
      This page is a deterministic Repo Unpack scan generated by CodeVetter{' '}
      {report.codevetterVersion.replace('codevetter ', '')} against commit{' '}
      <code>{report.commit.sha.slice(0, 10)}</code> ({report.commit.date}). It is a structural map —
      not a review, not a security audit, and not reviewed by the upstream maintainers. Deeper
      claim-cited analysis sections will appear here as the unpack pipeline matures.{' '}
      <a href="/download">Run Repo Unpack on your own repository.</a>
    </aside>
  </main>
  <Footer />
</Layout>

<style>
  .report{width:min(920px,calc(100% - 40px));margin:0 auto;padding:140px 0 90px}.back{color:#8c8e94;text-decoration:none;font-size:.85rem}header{padding:54px 0 34px;border-bottom:1px solid #24262b}.eyebrow{color:#85888f;text-transform:uppercase;letter-spacing:.16em;font-size:.7rem}h1{color:#f0efeb;font-size:clamp(2.2rem,5vw,3.8rem);line-height:1.02;letter-spacing:-.05em;margin:16px 0;font-family:ui-monospace,monospace}.meta{color:#85888f;font-size:.9rem;line-height:1.6}.upstream{margin-top:10px;color:#85888f;font-size:.9rem}.upstream a{color:#d9b567}.lead{color:#92969e;line-height:1.7;margin-top:18px;font-size:1.05rem}section{margin-top:44px}h2{color:#e9e8e4;font-size:1.1rem;margin-bottom:16px}table{width:100%;border-collapse:collapse;font-size:.9rem}th{color:#85888f;text-align:left;font-weight:400;text-transform:uppercase;letter-spacing:.1em;font-size:.68rem;padding:8px 12px;border-bottom:1px solid #24262b}td{color:#c9cbd1;padding:8px 12px;border-bottom:1px solid #1c1f24}code{color:#8b8e95;font-size:.85em}p{color:#92969e;line-height:1.65}li{color:#c9cbd1;line-height:1.8;list-style:none;padding-left:0}ul{padding-left:0}.dim{color:#73767d}.deps code,.docs code{display:inline-block;margin:2px 6px 2px 0}.note{color:#73767d;font-size:.85rem;border-left:2px solid #d4a039;padding-left:14px}aside{margin-top:44px;padding:20px;border-left:2px solid #d4a039;background:#101114;color:#92959c;line-height:1.65;font-size:.9rem}aside a{color:#d9b567}
</style>
