---
import Icon from './Icon.astro';
import GitHubIcon from './GitHubIcon.astro';

const newsletterProjectKey = import.meta.env.PUBLIC_SAASMAKER_NEWSLETTER_KEY?.trim();

const cols = [
  {
    label: 'Product',
    items: [
      { l: 'Run a verification', h: '/#run' },
      { l: 'How it works', h: '/#how' },
      { l: 'Availability', h: '/#availability' },
      { l: 'Changelog', h: '/changelog' },
      { l: 'Roadmap', h: 'https://github.com/Codevetter/codevetter/issues' },
      { l: 'Starboard — repo discovery', h: 'https://starboard.codevetter.com' },
    ],
  },
  {
    label: 'Resources',
    items: [
      { l: 'Evidence documentation', h: '/verification-evidence-bundle' },
      { l: 'FAQ', h: '/faq' },
      { l: 'Verification guide', h: '/coding-agent-verification' },
      { l: 'Articles', h: '/articles' },
      { l: 'Inspiration', h: '/inspiration' },
      { l: 'Review vs verification', h: '/ai-code-review-vs-verification' },
      { l: 'Compare CodeVetter', h: '/compare' },
      { l: 'vs CodeRabbit', h: '/codevetter-vs-coderabbit' },
      { l: 'vs Greptile', h: '/codevetter-vs-greptile' },
      { l: 'Benchmark', h: '/benchmark' },
    ],
  },
  {
    label: 'Connect',
    items: [
      { l: 'About', h: '/about' },
      { l: 'Contact', h: '/contact' },
      { l: 'Privacy', h: '/privacy' },
      { l: 'Terms', h: '/terms' },
      { l: 'Source', h: 'https://github.com/Codevetter/codevetter', icon: 'github', iconOnly: true },
      { l: 'Twitter', h: 'https://x.com/sarthakcodes', icon: 'twitter' },
      { l: 'Email', h: 'mailto:hello@codevetter.dev', icon: 'mail' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="cv-precise-footer" aria-label="CodeVetter footer">
  <fleet-footer-extension
    data-fleet-footer-project="codevetter"
    product-name="CodeVetter"
    theme="dark"
    surface="web"
    font-base="/fonts/fleet-footer-precise-v1/"
    signature-font="inherit"
    signature-name="CodeVetter"
    art-src="/footer-art/codevetter-evidence-workbench-v1.webp"
    art-alt="An illustrated verification workbench connects a code change, test results, and a review verdict."
    art-width="2172"
    art-height="724"
    art-position="50% 52%"
    art-credit="Original illustration for CodeVetter"
  >
    <div slot="navigation" class="cv-precise-navigation-frame">
      <div class="cv-precise-navigation">
        <div class="cv-precise-identity">
          <a href="/" aria-label="CodeVetter home" class="cv-precise-wordmark">CodeVetter</a>
          <p>
            Execution-backed verification for coding-agent changes. Preserve the task, exact
            change, executable evidence, limitations, and measurable verdict.
          </p>
        </div>

        <nav aria-label="CodeVetter footer navigation" class="cv-precise-links">
          {cols.map((c) => (
            <div>
              <h2>{c.label}</h2>
              <ul>
                {c.items.map((it) => (
                  <li>
                    <a
                      href={it.h}
                      aria-label={it.iconOnly ? 'GitHub repository' : undefined}
                      title={it.iconOnly ? 'GitHub repository' : undefined}
                      target={it.iconOnly ? '_blank' : undefined}
                      rel={it.iconOnly ? 'noopener noreferrer' : undefined}
                    >
                      {it.iconOnly ? (
                        <GitHubIcon width={20} height={20} />
                      ) : (
                        <>
                          {it.icon && <Icon name={it.icon} width={14} height={14} />}
                          {it.l}
                        </>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>

        <div class="cv-precise-legal">
          <span>© {year} CodeVetter · ISC License</span>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="https://sarthakagrawal.dev">Sarthak</a>
          <span>Review suggests. Evidence decides.</span>
        </div>
      </div>
    </div>

    <div slot="cta" class="cv-precise-cta">
      <p>Check the record behind a verdict.</p>
      <a href="/benchmark" data-log="benchmark_opened">Inspect public evidence →</a>
    </div>

    {newsletterProjectKey && (
      <saas-maker-newsletter-capture
        slot="capture"
        product-name="CodeVetter"
        project-key={newsletterProjectKey}
        source="codevetter-footer"
        kind="newsletter"
        layout="compact"
        integrated
        privacy-url="https://codevetter.com/privacy"
        theme="dark"
      ></saas-maker-newsletter-capture>
    )}
  </fleet-footer-extension>

</footer>

<script>
  // A partly visible shadow-DOM link can retain focus without native scrolling.
  // Reveal its label and focus outline in the existing studio viewport.
  for (const footer of document.querySelectorAll('.cv-precise-footer')) {
    const observer = new MutationObserver(bindStudioFocus);
    function bindStudioFocus() {
      const strip = footer.querySelector('portfolio-project-strip');
      const root = strip?.shadowRoot;
      if (!root) return;
      // Focus moving between links is retargeted to the same host outside this root.
      root.addEventListener('focusin', (event) => {
        const link = event.target;
        if (!(link instanceof HTMLAnchorElement) || strip.getAttribute('layout') !== 'studio') return;
        const viewport = link.closest<HTMLElement>('[role="region"]');
        if (!viewport) return;

        const bounds = viewport.getBoundingClientRect();
        const focused = link.getBoundingClientRect();
        const inset = 8;
        if (focused.right > bounds.right - inset) {
          viewport.scrollLeft += focused.right - bounds.right + inset;
        } else if (focused.left < bounds.left + inset) {
          viewport.scrollLeft -= bounds.left - focused.left + inset;
        }
      });
      observer.disconnect();
    }
    observer.observe(footer, { childList: true, subtree: true });
    void customElements.whenDefined('portfolio-project-strip').then(bindStudioFocus);
  }
</script>

<style>
  .cv-precise-footer {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: clip;
    border: 0;
    background: #050505;
    color: #e6e8eb;
  }

  fleet-footer-extension {
    display: block;
    width: 100%;
    color: #e6e8eb;
    background: #050505;
  }

  .cv-precise-navigation-frame {
    width: 100%;
    min-width: 0;
    container-type: inline-size;
  }

  .cv-precise-navigation {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    width: 100%;
    min-width: 0;
    color: #e6e8eb;
    font: 0.875rem/1.55 ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .cv-precise-identity {
    max-width: 34rem;
  }

  .cv-precise-wordmark {
    color: #fff;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .cv-precise-identity p {
    max-width: 34rem;
    margin: 0.75rem 0 0;
    color: #9aa0aa;
  }

  .cv-precise-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    min-width: 0;
  }

  .cv-precise-links h2 {
    margin: 0 0 0.65rem;
    color: #9aa0aa;
    font: 600 0.7rem/1.4 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cv-precise-links ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cv-precise-links a,
  .cv-precise-legal a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    color: #c8cbd1;
    text-decoration: none;
    text-underline-offset: 0.22em;
  }

  .cv-precise-links a:hover,
  .cv-precise-links a:focus-visible,
  .cv-precise-legal a:hover,
  .cv-precise-legal a:focus-visible {
    color: #fbbf24;
    text-decoration: underline;
  }

  .cv-precise-wordmark:focus-visible,
  .cv-precise-links a:focus-visible,
  .cv-precise-legal a:focus-visible,
  .cv-precise-cta a:focus-visible {
    outline: 2px solid #fbbf24;
    outline-offset: 4px;
  }

  .cv-precise-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 9%);
    color: #9298a2;
    font: 0.7rem/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .cv-precise-legal a {
    min-height: 2.75rem;
  }

  .cv-precise-cta {
    display: grid;
    gap: 0.65rem;
    max-width: 24rem;
    color: #c8cbd1;
  }

  .cv-precise-cta p {
    margin: 0;
    color: #9aa0aa;
  }

  .cv-precise-cta a {
    display: inline-flex;
    width: fit-content;
    min-height: 2.75rem;
    align-items: center;
    color: #fbbf24;
    font-weight: 600;
    text-underline-offset: 0.22em;
  }

  @container (min-width: 42rem) {
    .cv-precise-navigation {
      grid-template-columns: minmax(12rem, 0.9fr) minmax(0, 2fr);
      gap: 2.5rem;
    }

    .cv-precise-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .cv-precise-legal {
      grid-column: 1 / -1;
    }
  }
</style>
