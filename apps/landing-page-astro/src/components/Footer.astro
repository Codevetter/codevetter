---
import Icon from './Icon.astro';

const cols = [
  {
    label: 'Product',
    items: [
      { l: 'Run a verification', h: '/#run' },
      { l: 'How it works', h: '/#how' },
      { l: 'Availability', h: '/#availability' },
      { l: 'Changelog', h: '/changelog' },
      { l: 'Roadmap', h: 'https://github.com/Codevetter/codevetter/issues' },
    ],
  },
  {
    label: 'Resources',
    items: [
      { l: 'Evidence documentation', h: '/verification-evidence-bundle' },
      { l: 'FAQ', h: '/faq' },
      { l: 'Verification guide', h: '/coding-agent-verification' },
      { l: 'Review vs verification', h: '/ai-code-review-vs-verification' },
      { l: 'Compare CodeVetter', h: '/compare' },
      { l: 'vs CodeRabbit', h: '/codevetter-vs-coderabbit' },
      { l: 'vs Greptile', h: '/codevetter-vs-greptile' },
      { l: 'Benchmark', h: '/benchmark' },
      { l: 'Privacy', h: '/privacy' },
      { l: 'Terms', h: '/terms' },
    ],
  },
  {
    label: 'Connect',
    items: [
      { l: 'About', h: '/about' },
      { l: 'Contact', h: '/contact' },
      { l: 'Source', h: 'https://github.com/Codevetter/codevetter', icon: 'github' },
      { l: 'Twitter', h: 'https://x.com/sarthakcodes', icon: 'twitter' },
      { l: 'Email', h: 'mailto:hello@codevetter.dev', icon: 'mail' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/5 bg-[#050505] pt-24 pb-12 overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-6 gap-12">
    <div class="col-span-2 space-y-6">
      <div class="flex items-center gap-2.5">
        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-blue-500/10 border border-blue-500/20">
          <Icon name="search-code" class="w-4 h-4 text-blue-400" width={16} height={16} />
        </div>
        <span class="font-display text-lg font-bold tracking-tight text-white">
          CodeVetter
        </span>
      </div>
      <p class="text-sm text-gray-400 max-w-xs leading-relaxed">
        Execution-backed verification for coding-agent changes. Preserve the
        task, exact change, executable evidence, limitations, and measurable verdict.
      </p>
      <a href="/benchmark" class="inline-flex text-xs font-mono text-[--color-accent] hover:underline">Inspect public evidence →</a>
    </div>

    {cols.map((c) => (
      <div class="col-span-1">
        <div class="text-xs font-bold text-white uppercase tracking-widest mb-6">
          {c.label}
        </div>
        <ul class="space-y-4">
          {c.items.map((it) => (
            <li>
              <a
                href={it.h}
                class="flex items-center gap-2 text-sm text-gray-300 hover:text-white transition-colors group"
              >
                {it.icon && (
                  <span class="text-gray-400 group-hover:text-blue-300 transition-colors">
                    <Icon name={it.icon} width={14} height={14} class="w-3.5 h-3.5" />
                  </span>
                )}
                {it.l}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="max-w-7xl mx-auto px-6 mt-16 pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-gray-400 font-medium">
    <div class="flex items-center gap-6">
      <span>© {year} CodeVetter · ISC License</span>
      <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
      <a href="/terms" class="hover:text-white transition-colors">Terms</a>
      <a href="https://sarthakagrawal.dev" class="hover:text-white transition-colors">Sarthak</a>
    </div>
    <div class="flex items-center gap-2">
      <span>Review suggests. Evidence decides.</span>
    </div>
  </div>
</footer>
