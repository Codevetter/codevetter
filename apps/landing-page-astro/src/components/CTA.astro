---
import Icon from './Icon.astro';
import { currentReleaseUrl } from '@/data/release';
---

<section id="download" class="relative overflow-hidden py-28">
  <div class="absolute inset-0 grid-bg opacity-30 pointer-events-none" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-5xl px-6">
    <div class="corner-frame relative overflow-hidden border border-[--color-line] bg-[--color-surface] p-8 shadow-[0_30px_100px_-42px_rgba(56,189,248,0.55)] sm:p-12 md:p-16">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(56,189,248,0.14),transparent_58%)] pointer-events-none" aria-hidden="true"></div>
      <div class="relative mx-auto flex max-w-3xl flex-col items-center text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-500/10 px-4 py-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-blue-300">
          Current public artifact · macOS Apple silicon
        </div>
        <h2 class="mt-8 font-display text-[clamp(2.5rem,6vw,5rem)] font-bold leading-[1.02] tracking-tight text-white">“Looks good” is not a <span class="text-gradient">verdict.</span></h2>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-gray-400">Inspect the evidence contract first, then download the current local desktop build from the project’s GitHub release.</p>

        <div class="mt-10 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row">
          <a
            href={currentReleaseUrl}
            class="group inline-flex h-[52px] w-full items-center justify-center gap-2 rounded-full bg-white px-7 text-sm font-medium text-black transition-all hover:bg-gray-100 sm:w-auto"
          >
            <Icon name="download" class="h-4 w-4" width={16} height={16} />
            Open the latest release
            <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" width={16} height={16} />
          </a>
          <a
            href="/verification-evidence-bundle"
            class="inline-flex h-[52px] w-full items-center justify-center rounded-full border border-white/20 bg-white/[0.03] px-7 text-sm font-medium text-white transition-colors hover:border-white/40 hover:bg-white/[0.06] sm:w-auto"
          >
            Read the evidence format
          </a>
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-xs font-medium text-gray-400">
          <span class="flex items-center gap-2"><Icon name="check" class="h-3.5 w-3.5 text-emerald-400" width={14} height={14} />No CodeVetter account</span>
          <span class="flex items-center gap-2"><Icon name="check" class="h-3.5 w-3.5 text-emerald-400" width={14} height={14} />Local SQLite state</span>
          <span class="flex items-center gap-2"><Icon name="check" class="h-3.5 w-3.5 text-emerald-400" width={14} height={14} />ISC source license</span>
        </div>
      </div>
    </div>
  </div>
</section>
