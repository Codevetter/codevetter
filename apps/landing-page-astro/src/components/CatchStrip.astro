---
const stages = [
  { n: '01', label: 'Task', detail: 'Preserve the requested outcome.' },
  { n: '02', label: 'Change', detail: 'Bind the exact agent revision.' },
  { n: '03', label: 'Execute', detail: 'Run authoritative local checks.' },
  { n: '04', label: 'Evidence', detail: 'Retain outputs and limitations.' },
  { n: '05', label: 'Verdict', detail: 'Pass, fail, or unverified.' },
];
---

<section class="relative border-y border-[--color-line] bg-black/35 py-10">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-7 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
      <h2 class="font-display text-xl font-semibold text-white">The unit of trust is the whole chain.</h2>
      <p class="max-w-xl text-sm leading-relaxed text-gray-400">A finding or green command alone is not proof. CodeVetter keeps task identity, execution, evidence, and uncertainty connected.</p>
    </div>
    <ol class="grid gap-px overflow-hidden rounded-2xl border border-white/5 bg-white/5 sm:grid-cols-2 lg:grid-cols-5">
      {stages.map((stage) => (
        <li class="bg-[#090a0c] p-5">
          <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-blue-400">{stage.n} · {stage.label}</div>
          <p class="mt-3 text-sm leading-relaxed text-gray-400">{stage.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
