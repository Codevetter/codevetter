---
import Icon from './Icon.astro';
---

<section class="relative overflow-hidden pb-24 pt-32">
  <div class="absolute inset-0 grid-bg opacity-35 pointer-events-none" aria-hidden="true"></div>
  <div
    class="absolute left-1/2 top-20 h-[34rem] w-[64rem] -translate-x-1/2 rounded-full blur-3xl pointer-events-none"
    style="background: radial-gradient(circle, rgba(56,189,248,0.14), transparent 68%);"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <div class="mb-8 flex flex-wrap items-center justify-center gap-2">
        <span class="inline-flex items-center gap-2 rounded-full border border-blue-500/20 bg-blue-500/10 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-blue-300">
          <span class="h-1.5 w-1.5 rounded-full bg-[--color-accent]"></span>
          Execution-backed verification
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-gray-400">
          Local-first · open source
        </span>
      </div>

      <h1 class="font-display text-[clamp(3rem,7vw,6.5rem)] font-bold leading-[0.98] tracking-[-0.045em] text-white">
        <span class="block">AI writes code fast.</span>
        <span class="block">
          It leaves it
          <span class="sr-only">unoptimized, untested, or unreviewed.</span>
          <span
            id="agent-change-state"
            class="inline-block min-w-[12ch] text-center text-gradient sm:min-w-[13ch]"
            aria-hidden="true"
          >unoptimized</span><span aria-hidden="true">.</span>
        </span>
      </h1>

      <p class="mt-8 max-w-3xl text-[clamp(1.05rem,2vw,1.3rem)] leading-relaxed text-gray-300">
        CodeVetter helps engineers evaluate coding-agent changes. It binds the
        requested task to the exact change, runs repository-owned checks, and
        preserves a pass, fail, or unverified verdict with the evidence and
        limitations behind it.
      </p>

      <div class="mt-10 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row">
        <a
          href="#run"
          class="group inline-flex h-12 w-full items-center justify-center gap-2 rounded-full bg-white px-6 text-sm font-medium text-black shadow-[0_0_24px_rgba(255,255,255,0.16)] transition-all hover:bg-gray-100 hover:shadow-[0_0_34px_rgba(255,255,255,0.28)] sm:w-auto"
        >
          Run a verification
          <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" width={16} height={16} />
        </a>
        <a
          href="#download"
          class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-full border border-white/20 bg-white/[0.03] px-6 text-sm font-medium text-white transition-colors hover:border-white/40 hover:bg-white/[0.06] sm:w-auto"
        >
          <Icon name="apple" class="h-4 w-4 text-gray-300" width={16} height={16} />
          Get the macOS build
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-[10px] uppercase tracking-[0.16em] text-[--color-text-mute]">
        <span>Exact source identity</span>
        <span class="text-[--color-line-2]" aria-hidden="true">/</span>
        <span>Executable checks</span>
        <span class="text-[--color-line-2]" aria-hidden="true">/</span>
        <span>Explicit unknowns</span>
        <span class="text-[--color-line-2]" aria-hidden="true">/</span>
        <span>No hosted verifier</span>
      </div>
    </div>

    <div class="mx-auto mt-20 max-w-6xl">
      <div class="corner-frame relative overflow-hidden border border-[--color-line] bg-[--color-surface] shadow-[0_30px_100px_-38px_rgba(56,189,248,0.42)]">
        <div class="flex flex-col gap-3 border-b border-[--color-line] bg-[--color-bg-elev]/75 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <Icon name="shield-check" class="h-4 w-4 text-[--color-accent]" width={16} height={16} />
            <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-gray-300">Verification receipt anatomy</span>
          </div>
          <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-[--color-text-mute]">Illustrative fields · not a benchmark result</span>
        </div>

        <div class="grid lg:grid-cols-[1.1fr_0.9fr]">
          <div class="border-b border-[--color-line] p-6 sm:p-8 lg:border-b-0 lg:border-r">
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-xl border border-white/5 bg-black/35 p-4">
                <div class="label-mono">Requested task</div>
                <p class="mt-3 text-sm leading-relaxed text-white">Reject expired sessions without breaking valid refreshes.</p>
              </div>
              <div class="rounded-xl border border-white/5 bg-black/35 p-4">
                <div class="label-mono">Exact change</div>
                <p class="mt-3 break-all font-mono text-xs leading-relaxed text-blue-300">main…agent/session-expiry · a13c9f2</p>
              </div>
              <div class="rounded-xl border border-white/5 bg-black/35 p-4 sm:col-span-2">
                <div class="flex items-center justify-between gap-4">
                  <div class="label-mono">Repository-owned checks</div>
                  <span class="rounded-full border border-red-500/20 bg-red-500/10 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-red-300">1 failed</span>
                </div>
                <div class="mt-4 space-y-3 font-mono text-xs">
                  <div class="flex items-center justify-between gap-4 border-b border-white/5 pb-3 text-gray-300">
                    <span>pnpm test auth/session.test.ts</span>
                    <span class="text-red-300">exit 1</span>
                  </div>
                  <div class="flex items-center justify-between gap-4 text-gray-300">
                    <span>pnpm typecheck</span>
                    <span class="text-emerald-300">exit 0</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="flex flex-col bg-black/20 p-6 sm:p-8">
            <div class="label-mono">Measurable verdict</div>
            <div class="mt-5 flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-full border border-red-500/25 bg-red-500/10 text-red-300">
                <Icon name="shield-alert" class="h-5 w-5" width={20} height={20} />
              </span>
              <div>
                <div class="font-display text-3xl font-bold text-white">Fail</div>
                <div class="mt-1 text-sm text-gray-400">The requested behavior is not verified.</div>
              </div>
            </div>

            <div class="mt-8 space-y-5">
              <div>
                <div class="label-mono">Evidence</div>
                <p class="mt-2 text-sm leading-relaxed text-gray-300">The expired-session assertion reproduced against the exact agent revision.</p>
              </div>
              <div>
                <div class="label-mono">Limitation</div>
                <p class="mt-2 text-sm leading-relaxed text-gray-400">The browser refresh journey was not executed, so that behavior remains unverified.</p>
              </div>
            </div>

            <a href="/benchmark" class="mt-auto pt-8 text-sm font-medium text-[--color-accent] hover:underline">
              Inspect published benchmark evidence →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const target = document.querySelector('#agent-change-state');
    if (!(target instanceof HTMLElement)) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const states = ['unoptimized', 'untested', 'unreviewed'];
    let index = 0;

    window.setInterval(() => {
      index = (index + 1) % states.length;
      if (reducedMotion || typeof target.animate !== 'function') {
        target.textContent = states[index];
        return;
      }

      const exit = target.animate(
        [
          { opacity: 1, transform: 'translateY(0)' },
          { opacity: 0, transform: 'translateY(-0.18em)' },
        ],
        { duration: 180, easing: 'ease-in', fill: 'forwards' },
      );

      exit.finished.then(() => {
        target.textContent = states[index];
        target.animate(
          [
            { opacity: 0, transform: 'translateY(0.18em)' },
            { opacity: 1, transform: 'translateY(0)' },
          ],
          { duration: 220, easing: 'ease-out', fill: 'forwards' },
        );
      });
    }, 2200);
  })();
</script>
