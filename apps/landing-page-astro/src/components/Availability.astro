---
import Icon from './Icon.astro';

const cards = [
  {
    label: 'Public build',
    title: 'macOS · Apple silicon',
    body: 'The current GitHub release publishes an aarch64 DMG and updater archive. Other platform installers are not currently published.',
    icon: 'apple',
  },
  {
    label: 'Product model',
    title: 'Local, no CodeVetter account',
    body: 'Product state and verification evidence live on the machine. Model-backed review is optional and uses the credentials or authenticated CLI you configure.',
    icon: 'cpu',
  },
  {
    label: 'Source',
    title: 'Open source · ISC',
    body: 'The repository, benchmark cases, scorer, product docs, and release workflows are public and inspectable on GitHub.',
    icon: 'github',
  },
];
---

<section id="availability" class="relative overflow-hidden py-28">
  <div class="absolute inset-0 grid-bg opacity-20 pointer-events-none" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mb-6 inline-flex items-center rounded-full border border-blue-500/20 bg-blue-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-blue-300">Current availability</div>
      <h2 class="font-display text-[clamp(2.4rem,5vw,4.2rem)] font-bold leading-[1.05] tracking-tight text-white">What you can use <span class="text-gradient">today.</span></h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-400">No placeholder plans, unsupported installers, or hosted-service promises.</p>
    </div>

    <div class="mt-16 grid gap-6 lg:grid-cols-3">
      {cards.map((card) => (
        <article class="rounded-3xl border border-white/5 bg-white/[0.02] p-8">
          <div class="flex h-11 w-11 items-center justify-center rounded-2xl border border-blue-500/20 bg-blue-500/10 text-blue-300">
            <Icon name={card.icon} class="h-5 w-5" width={20} height={20} />
          </div>
          <div class="mt-7 font-mono text-[10px] uppercase tracking-[0.18em] text-gray-400">{card.label}</div>
          <h3 class="mt-3 text-2xl font-semibold tracking-tight text-white">{card.title}</h3>
          <p class="mt-4 text-[15px] leading-relaxed text-gray-400">{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
