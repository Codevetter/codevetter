---
import Icon from './Icon.astro';

const steps = [
  {
    n: '01',
    title: 'Freeze the task and change',
    body: 'Record the requested behavior, exact revision range, repository state, and the checks that can actually observe success.',
    icon: 'git-pull-request-arrow',
    fields: ['task: reject expired sessions', 'change: main…a13c9f2', 'scope: auth/session'],
  },
  {
    n: '02',
    title: 'Run the evidence boundary',
    body: 'Execute the smallest authoritative repository-owned checks. Review findings may suggest risk, but they do not become the verdict.',
    icon: 'terminal',
    fields: ['test: exit 1', 'typecheck: exit 0', 'browser: not run'],
  },
  {
    n: '03',
    title: 'Keep verdict and limits together',
    body: 'Export the result with commands, bounded output, artifacts, provenance, and explicit gaps so another person or agent can re-check it.',
    icon: 'shield-check',
    fields: ['verdict: fail', 'evidence: retained', 'limits: explicit'],
  },
];
---

<section id="how" class="relative overflow-hidden py-28">
  <div class="relative mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mb-6 inline-flex items-center rounded-full border border-blue-500/20 bg-blue-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-blue-300">Operating loop</div>
      <h2 class="font-display text-[clamp(2.4rem,5vw,4.2rem)] font-bold leading-[1.05] tracking-tight text-white">From agent claim to <span class="text-gradient">inspectable verdict.</span></h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-400">CodeVetter is designed around acceptance evidence, not a second model’s confidence.</p>
    </div>

    <ol class="mt-16 grid gap-6 lg:grid-cols-3">
      {steps.map((step) => (
        <li class="relative overflow-hidden rounded-3xl border border-white/5 bg-white/[0.02] p-7 sm:p-8">
          <div class="flex items-center justify-between">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-blue-500/20 bg-blue-500/10 text-blue-300">
              <Icon name={step.icon} class="h-5 w-5" width={20} height={20} />
            </span>
            <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-blue-300">Step {step.n}</span>
          </div>
          <h3 class="mt-7 text-2xl font-semibold tracking-tight text-white">{step.title}</h3>
          <p class="mt-4 text-[15px] leading-relaxed text-gray-400">{step.body}</p>
          <div class="mt-7 space-y-2 rounded-2xl border border-white/5 bg-black/35 p-4 font-mono text-[11px] text-gray-400">
            {step.fields.map((field) => (
              <div class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-full bg-[--color-accent]"></span>
                <span>{field}</span>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
