// Release.xcconfig
// Release configuration for macOS projects - minimal overrides only
// Generated by XcodeBuildMCP

#include "Shared.xcconfig"

// CodeVetter executes user-selected repository tools and supervised helpers.
// Outside the Mac App Store, Developer ID distribution requires Hardened
// Runtime but does not require App Sandbox. A sandbox would silently remove
// the product's core execution authority.
CODE_SIGN_ENTITLEMENTS = Config/CodeVetter.Release.entitlements
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO

// Release packages must not carry test coverage instrumentation. Preserve
// symbols in the adjacent dSYM while stripping the shipped executable and
// dead code during the Release build.
ENABLE_CODE_COVERAGE = NO
CLANG_ENABLE_CODE_COVERAGE = NO
CLANG_COVERAGE_MAPPING = NO
DEAD_CODE_STRIPPING = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
DEPLOYMENT_POSTPROCESSING = YES
STRIP_INSTALLED_PRODUCT = YES
STRIP_SWIFT_SYMBOLS = YES
