{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codevetter.com/schemas/agent-task/run-telemetry.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "clock", "elapsed_ms", "events", "resources"],
  "properties": {
    "schema_version": { "const": "codevetter.agent-task-telemetry.v1" },
    "clock": { "const": "monotonic" },
    "elapsed_ms": { "type": "integer", "minimum": 0, "maximum": 7200000 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "name", "start_offset_ms", "duration_ms", "outcome"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1, "maximum": 20 },
          "name": {
            "enum": ["workspace_prepare", "agent_execute", "checks_execute", "cleanup"]
          },
          "start_offset_ms": { "type": "integer", "minimum": 0, "maximum": 7200000 },
          "duration_ms": { "type": "integer", "minimum": 0, "maximum": 7200000 },
          "outcome": { "enum": ["complete", "failed", "skipped"] }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "sampler",
        "sample_count",
        "peak_rss_bytes",
        "cpu_time_ms",
        "io_read_bytes",
        "io_write_bytes",
        "network_rx_bytes",
        "network_tx_bytes",
        "thermal_state",
        "limitations"
      ],
      "properties": {
        "scope": { "const": "agent-process-tree" },
        "sampler": { "enum": ["ps-process-tree-v1", "unavailable"] },
        "sample_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "peak_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "cpu_time_ms": { "type": ["integer", "null"], "minimum": 0 },
        "io_read_bytes": { "type": "null" },
        "io_write_bytes": { "type": "null" },
        "network_rx_bytes": { "type": "null" },
        "network_tx_bytes": { "type": "null" },
        "thermal_state": { "type": "null" },
        "limitations": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
