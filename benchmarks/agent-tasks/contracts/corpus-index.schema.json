{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codevetter.com/schemas/agent-task/corpus-index-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "version", "tasks"],
  "properties": {
    "schema_version": { "const": "codevetter.agent-task-corpus.v1" },
    "corpus_id": { "$ref": "./common.schema.json#/$defs/id" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tasks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "manifest"],
        "properties": {
          "task_id": { "$ref": "./common.schema.json#/$defs/id" },
          "manifest": { "$ref": "./common.schema.json#/$defs/artifact" },
          "qualification": { "$ref": "./common.schema.json#/$defs/artifact" }
        }
      }
    }
  }
}
