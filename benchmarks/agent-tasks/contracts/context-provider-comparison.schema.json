{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codevetter.com/schemas/agent-task/context-provider-comparison.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "plan_sha256",
    "scorer_sha256",
    "status",
    "providers",
    "missing_arms",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "codevetter.context-provider-comparison.v1" },
    "comparison_id": { "$ref": "common.schema.json#/$defs/id" },
    "plan_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "scorer_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "status": { "enum": ["descriptive", "qualified", "invalid"] },
    "providers": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "provider_version",
          "configuration_sha256",
          "context_kind",
          "snapshots",
          "allowed_tools",
          "pairwise_score",
          "pairwise_bundle",
          "scheduled_attempts",
          "complete_attempts",
          "outcomes",
          "diagnostics_available",
          "raw_p_value",
          "adjusted_p_value",
          "pairwise_qualified",
          "family_qualified"
        ],
        "properties": {
          "provider_id": { "$ref": "common.schema.json#/$defs/id" },
          "provider_version": { "type": "string", "minLength": 1, "maxLength": 120 },
          "configuration_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "context_kind": { "enum": ["graph", "search", "wiki-rag", "hybrid"] },
          "snapshots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id",
                "source_sha256",
                "status",
                "snapshot_id",
                "indexed_revision"
              ],
              "properties": {
                "task_id": { "$ref": "common.schema.json#/$defs/id" },
                "source_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
                "status": { "const": "ready" },
                "snapshot_id": { "$ref": "common.schema.json#/$defs/snapshotId" },
                "indexed_revision": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                }
              }
            }
          },
          "allowed_tools": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "pairwise_score": { "$ref": "common.schema.json#/$defs/artifact" },
          "pairwise_bundle": { "$ref": "common.schema.json#/$defs/artifact" },
          "scheduled_attempts": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "complete_attempts": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "outcomes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "complete_pairs",
              "control_successes",
              "treatment_successes",
              "treatment_wins",
              "control_wins",
              "ties",
              "success_rate_delta",
              "regression_delta"
            ],
            "properties": {
              "complete_pairs": { "type": "integer", "minimum": 0, "maximum": 5000 },
              "control_successes": { "type": "integer", "minimum": 0, "maximum": 5000 },
              "treatment_successes": { "type": "integer", "minimum": 0, "maximum": 5000 },
              "treatment_wins": { "type": "integer", "minimum": 0, "maximum": 5000 },
              "control_wins": { "type": "integer", "minimum": 0, "maximum": 5000 },
              "ties": { "type": "integer", "minimum": 0, "maximum": 5000 },
              "success_rate_delta": { "type": "number", "minimum": -1, "maximum": 1 },
              "regression_delta": { "type": "integer", "minimum": -5000, "maximum": 5000 }
            }
          },
          "diagnostics_available": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 80 }
          },
          "raw_p_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "adjusted_p_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "pairwise_qualified": { "type": "boolean" },
          "family_qualified": { "type": "boolean" }
        }
      }
    },
    "missing_arms": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "limitations": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  }
}
